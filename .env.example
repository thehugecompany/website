# Copy to .env.local and fill in. Both are safe to expose — they end up in the
# client bundle by design. The secrets (Turnstile secret key, Resend API key,
# and the destination address) live only in the Worker, set via
# `wrangler secret put`.

# Turnstile *site* key, from the Cloudflare dashboard > Turnstile.
# 1x00000000000000000000AA is Cloudflare's "always passes" test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Deployed Worker URL. Locally this is what `npm run worker:dev` prints.
VITE_CONTACT_ENDPOINT=http://localhost:8787
